#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "config"
require "fedibird_api"

parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/whoami [options]",
  description: "sns-multipostの初期設定用に、Fedibird APIで自分のaccount_idとアカウント名を確認します。\n確認したaccount_idはconfig.ymlのfedibird設定へ記入します。",
  notes: ["投稿ジョブの作成や各SNSへの投稿は行いません。"])
SnsMultipost::Cli.parse!(parser)
SnsMultipost::Cli.reject_arguments!(parser)

config = SnsMultipost::Config.load
me = SnsMultipost::FedibirdApi.new(
  base_url: config["fedibird"]["base_url"],
  access_token: config["fedibird"]["access_token"]).verify_credentials
puts "account_id: #{me['id']}"
puts "acct: @#{me['acct']}"
