#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "config"
require "job_queue"
require "runner"
require "poster/all"

parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/retry [options] FILE...",
  description: "failed/ の失敗ジョブをキューへ戻して再実行します。",
  examples: ["ruby bin/retry failed/20260805-120000_bluesky_ab12.json"],
  notes: ["dry_run: false の場合は実投稿します。複数ファイルを指定できます。"])
SnsMultipost::Cli.parse!(parser)
if ARGV.empty?
  SnsMultipost::Cli.usage_error(parser, "失敗ジョブのJSONファイルを指定してください")
end

config = SnsMultipost::Config.load
queue = SnsMultipost::JobQueue.new
requeued = ARGV.map { |p| queue.requeue(File.expand_path(p)) }
jobs = queue.pending.select { |j| requeued.include?(j.path) }
results = SnsMultipost::Runner.new(config: config, queue: queue).run(jobs)
results.each do |job, status, detail|
  puts "#{status}\t#{job.sns}\t#{detail.inspect[0, 120]}"
end
