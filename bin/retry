#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "config"
require "job_queue"
require "runner"
require "run_lock"
require "poster/all"
require "json"

confirm_not_posted = false
confirm_posted = false
parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/retry [options] FILE...",
  description: "sns-multipostで失敗したfailed/のジョブをqueue/へ戻し、そのジョブだけ再実行します。\n通常はbin/run_queueの結果がfailedになった後、原因を直してから使用します。",
  examples: ["ruby bin/retry failed/20260805-120000_bluesky_ab12.json"],
  notes: ["dry_run: false の場合は実投稿します。",
          "別のrun_queueまたはretryが実行中なら、二重投稿を避けるため処理せず終了します。",
          "delivery_state=unknownのジョブは、投稿先で未投稿を確認して--confirm-not-postedを付けるまで再投稿しません。",
          "投稿済みだったunknownジョブは--confirm-postedで再投稿せずdone/へ移して解決します。",
          "--confirm-not-postedは今回指定したすべてのunknownジョブに適用します。",
          "複数の失敗ジョブをまとめて指定できます。"]
) do |opts|
  opts.on("--confirm-not-posted", "投稿先で未投稿を確認済みとしてunknownジョブを再試行") do
    confirm_not_posted = true
  end
  opts.on("--confirm-posted", "投稿先で投稿済みを確認し、再投稿せずdoneへ移動") do
    confirm_posted = true
  end
end
SnsMultipost::Cli.parse!(parser)
if ARGV.empty?
  SnsMultipost::Cli.usage_error(parser, "失敗ジョブのJSONファイルを指定してください")
end
if confirm_not_posted && confirm_posted
  SnsMultipost::Cli.usage_error(
    parser, "--confirm-not-postedと--confirm-postedは同時に指定できません")
end

unknown = ARGV.filter_map do |path|
  data = JSON.parse(File.read(File.expand_path(path)))
  File.basename(path) if data["delivery_state"] == "unknown"
rescue Errno::ENOENT, JSON::ParserError => e
  SnsMultipost::Cli.usage_error(parser, "失敗ジョブを読めません: #{path}: #{e.message}")
end
if confirm_posted && unknown.length != ARGV.length
  SnsMultipost::Cli.usage_error(
    parser, "--confirm-postedはdelivery_state=unknownのジョブだけに使用できます")
end
if unknown.any? && !confirm_not_posted
  unless confirm_posted
    SnsMultipost::Cli.usage_error(
      parser,
      "投稿結果不明のため再試行を停止しました: #{unknown.join(', ')}\n" \
      "投稿先を確認し、未投稿なら --confirm-not-posted、投稿済みなら --confirm-posted を付けてください。")
  end
end

if confirm_posted
  acquired = SnsMultipost::RunLock.new.synchronize do
    queue = SnsMultipost::JobQueue.new
    ARGV.each do |path|
      destination = queue.resolve_as_posted(File.expand_path(path))
      puts "done\t#{File.basename(path)}\tconfirmed_posted -> #{destination}"
    end
  end
  unless acquired
    puts "skip: another run_queue or retry is active"
  end
  exit 0
end

config = SnsMultipost::Config.load
results = nil
acquired = SnsMultipost::RunLock.new.synchronize do
  queue = SnsMultipost::JobQueue.new
  requeued = ARGV.map do |path|
    queue.requeue(
      File.expand_path(path),
      confirmed_not_delivered: confirm_not_posted)
  end
  jobs = queue.pending.select { |j| requeued.include?(j.path) }
  results = SnsMultipost::Runner.new(config: config, queue: queue).run(jobs)
  results.each do |job, status, detail|
    puts "#{status}\t#{job.sns}\t#{detail.inspect[0, 120]}"
  end
end
unless acquired
  puts "skip: another run_queue or retry is active"
  exit 0
end
exit SnsMultipost::Runner.exit_status(results)
