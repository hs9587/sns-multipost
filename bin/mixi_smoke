#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "mixi_browser"

parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/mixi_smoke [options]",
  description: "sns-multipost専用Chromeのmixiログイン状態とつぶやきフォームを確認します。\n本文や画像は投稿せず、確認後にChromeを閉じます。",
  examples: ["ruby bin/mixi_smoke"],
  notes: ["先に ruby bin/browser_login mixi で専用Chromeへログインしてください。",
          "本文欄・つぶやくボタン・写真入力だけを確認し、投稿は行いません。"])
SnsMultipost::Cli.parse!(parser)
SnsMultipost::Cli.reject_arguments!(parser)

result = SnsMultipost::MixiBrowser.new.smoke
if result.values_at("hasText", "hasSubmit", "hasMedia").all?
  puts "mixi smoke test: ok"
  puts "ログイン状態とつぶやきフォーム（本文・送信・写真添付）を確認しました。"
else
  raise "mixiつぶやきフォームの構成が想定と違います: #{result.inspect}"
end
