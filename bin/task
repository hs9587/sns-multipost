#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "job_history"
require "task_status"
require "task_runner"
require "rbconfig"

task_name = "sns-multipost"
runner_path = File.expand_path("task_run", __dir__)
ruby_path = RbConfig.ruby
minutes = 10
parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/task [options] [ACTION]",
  description: "sns-multipost用Windowsタスクスケジューラの状態確認、登録、解除、有効化、一時停止を行います。\nPowerShell、コマンドプロンプト、Git Bashから同じように実行できます。",
  examples: ["ruby bin/task", "ruby bin/task dis", "ruby bin/task en",
             "ruby bin/task disable", "ruby bin/task enable",
             "ruby bin/task register", "ruby bin/task unregister",
             "ruby bin/task register --minutes 10",
             "ruby bin/task register --runner C:\\path\\custom-runner.bat"],
  notes: ["ACTIONを省略すると状態を読み取るだけです。",
          "ACTIONは register、unregister、enable、disable のいずれかです。enはenable、disはdisableの短縮名です。",
          "registerの既定はリポジトリ内の bin/task_run を現在のRubyで10分間隔に実行します。",
          "registerは同名タスクを上書きして有効化し、バッテリ動作と多重起動防止を設定します。",
          "unregisterはタスク登録だけを解除し、バッチ、ログ、ジョブは削除しません。",
          "切替後も現在の状態、次回・前回実行時刻、前回結果を表示します。",
          "状態表示ではdone最新と同時刻以降のfailedを最大3件示します。自動判定や再投稿はしません。",
          "disableは今後の起動を止めますが、すでに実行中の処理は強制終了しません。"]
) do |opts|
  opts.on("--task NAME", "確認または変更するWindowsタスク名") do |value|
    task_name = value
  end
  opts.on("--runner PATH", "registerで実行するラッパー（既定: bin/task_run）") do |value|
    runner_path = value
  end
  opts.on("--ruby PATH", "bin/task_runを実行するruby.exe（既定: 現在のRuby）") do |value|
    ruby_path = value
  end
  opts.on("--minutes N", Integer, "registerの実行間隔（1～1440分）") do |value|
    minutes = value
  end
end
SnsMultipost::Cli.parse!(parser)
if task_name.to_s.strip.empty?
  SnsMultipost::Cli.usage_error(parser, "タスク名を指定してください")
end
action_aliases = { "en" => "enable", "dis" => "disable" }.freeze
actions = %w[register unregister enable disable]
requested_action = ARGV.first
action = action_aliases.fetch(requested_action, requested_action)
unless ARGV.length <= 1 && (ARGV.empty? || actions.include?(action))
  SnsMultipost::Cli.usage_error(
    parser, "ACTIONを省略するか、register、unregister、enable（en）、disable（dis）のいずれかを指定してください")
end

begin
  case action
  when "register"
    SnsMultipost::TaskStatus.register(
      task_name, runner_path: runner_path, ruby_path: ruby_path, minutes: minutes)
    puts "登録: #{task_name}（#{minutes}分間隔、#{File.expand_path(runner_path)}）"
  when "unregister"
    SnsMultipost::TaskStatus.unregister(task_name)
    puts "解除: #{task_name}"
    puts "バッチ、ログ、queue、failed、doneは削除していません。"
    exit 0
  when "enable", "disable"
    SnsMultipost::TaskStatus.set_enabled(task_name, enabled: action == "enable")
    puts "変更: #{action == 'enable' ? '有効化' : '一時停止'}"
  end
  puts SnsMultipost::TaskStatus.format(SnsMultipost::TaskStatus.query(task_name))
  root = File.expand_path("..", __dir__)
  puts SnsMultipost::TaskRunner.format_status(SnsMultipost::TaskRunner.load_status(root))
  history = SnsMultipost::JobHistory.snapshot(
    done_directory: File.join(root, "done"), failed_directory: File.join(root, "failed"))
  puts SnsMultipost::JobHistory.format_summary(history)
rescue StandardError => e
  warn e.message
  exit 1
end
