#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "time"
require "cli"
require "config"
require "fedibird_api"
require "job_queue"
require "manual_post"
require "poster/all"
require "title_rules"

targets = []
images = []
from_fedibird_latest = false
parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/post [options] [TEXT...]",
  description: "sns-multipostへ本文と任意のローカル画像を手動投入し、queue/に投稿ジョブを作成します。\nTEXTを省略した場合、本文は「おはようございます」になります。\nジョブ作成後に ruby bin/run_queue を実行して、各SNSへ投稿します。",
  examples: ["ruby bin/post",
             'ruby bin/post --target jotter "Jotter ブラウザ投稿テスト"',
             'ruby bin/post --image photo.jpg "画像付き投稿"',
             'ruby bin/post --target fedibird --image photo.jpg "Fedibird画像投稿"',
             'ruby bin/post --target bluesky --image one.jpg --image two.jpg "二枚"',
             'ruby bin/post --target threads --target blogger --from-fedibird-latest',
             'ruby bin/post "任意の本文"',
             'ruby bin/post -- "-から始まる本文"'],
  notes: ["このコマンドだけでは各SNSへの投稿は実行しません。",
          "--targetは複数指定できます。省略時は用途に応じてtargets.postから投稿先を選びます。",
          "--imageは複数指定できます。Fedibird、Bluesky、Tumblr、mixi、mixi2のジョブだけを作ります。",
          "--from-fedibird-latestは最新Fedibird投稿の本文と画像URLをThreads、Bloggerへ渡します。",
          "画像は絶対パスに直してキューへ保存するため、run_queue完了まで移動・削除しないでください。"]
) do |opts|
  opts.on("-t", "--target SNS", "指定SNSだけをキューへ入れる（複数指定可）") do |value|
    targets << value.to_s.downcase
  end
  opts.on("-i", "--image PATH", "ローカル画像を添付（複数指定可）") do |value|
    images << value
  end
  opts.on("--from-fedibird-latest", "最新Fedibird投稿の本文と画像URLを利用") do
    from_fedibird_latest = true
  end
end
SnsMultipost::Cli.parse!(parser)
if from_fedibird_latest && !images.empty?
  SnsMultipost::Cli.usage_error(parser, "--imageと--from-fedibird-latestは同時に指定できません")
end
if from_fedibird_latest && !ARGV.empty?
  SnsMultipost::Cli.usage_error(parser, "--from-fedibird-latestではTEXTを指定しません")
end

unknown = targets.reject { |target| SnsMultipost::Poster::REGISTRY.key?(target) }
unless unknown.empty?
  SnsMultipost::Cli.usage_error(parser, "未実装のSNSです: #{unknown.join(', ')}")
end

config = SnsMultipost::Config.load
queue = SnsMultipost::JobQueue.new

begin
  image_paths = SnsMultipost::ManualPost.resolve_image_paths(images)
  if from_fedibird_latest
    fedibird = config["fedibird"] || {}
    source = SnsMultipost::ManualPost.latest_fedibird_source(
      api: SnsMultipost::FedibirdApi.new(
        base_url: fedibird["base_url"], access_token: fedibird["access_token"]),
      account_id: fedibird["account_id"])
    mode = :fedibird_latest
  else
    source = {
      text: SnsMultipost::Cli.text_or_default(default: "おはようございます"),
      media_urls: [], source_url: nil
    }
    mode = :local_images unless image_paths.empty?
  end
  selected_targets, skipped = SnsMultipost::ManualPost.select_targets(
    configured: config.targets_for(:post), targets: targets, mode: mode)
rescue ArgumentError => e
  SnsMultipost::Cli.usage_error(parser, e.message)
end
unless skipped.empty?
  warn "今回の画像経路に含めない投稿先: #{skipped.join(', ')}"
end

text = source[:text]
title = SnsMultipost::TitleRules.load.title_for(text)
if from_fedibird_latest
  puts "source: #{source[:source_url]} images=#{source[:media_urls].length}"
end

selected_targets.each do |sns|
  path = queue.enqueue(SnsMultipost::Job.new(
    sns: sns, text: text, title: title, media_paths: image_paths,
    media_urls: source[:media_urls], source_url: source[:source_url],
    created_at: Time.now.iso8601))
  puts "queued: #{path}"
end
puts "次: ruby bin/run_queue"
