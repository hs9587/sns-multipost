#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "fileutils"
require "cli"
require "config"
require "fedibird_api"
require "html_text"
require "title_rules"

parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/dryrun_titles [options] [COUNT]",
  description: "sns-multipostのタイトル辞書（title_rules.yml）を確認するためのコマンドです。\nFedibirdの過去投稿へ辞書を試し、導出タイトルと本文の一覧をTSVへ保存します。",
  examples: ["ruby bin/dryrun_titles", "ruby bin/dryrun_titles 500"],
  notes: ["投稿ジョブの作成や各SNSへの投稿は行いません。",
          "COUNTの省略時は200件です。出力先はlogs/dryrun_titles_*.tsvです。"])
if ARGV.first&.match?(/\A-\d+\z/)
  SnsMultipost::Cli.usage_error(parser, "COUNTは1以上の整数で指定してください")
end
SnsMultipost::Cli.parse!(parser)
if ARGV.size > 1
  SnsMultipost::Cli.usage_error(parser, "余分な引数があります: #{ARGV.drop(1).join(' ')}")
end
begin
  count = ARGV.empty? ? 200 : Integer(ARGV.first, 10)
rescue ArgumentError
  count = 0
end
if count < 1
  SnsMultipost::Cli.usage_error(parser, "COUNTは1以上の整数で指定してください")
end

config = SnsMultipost::Config.load
api = SnsMultipost::FedibirdApi.new(
  base_url: config["fedibird"]["base_url"],
  access_token: config["fedibird"]["access_token"])
titles = SnsMultipost::TitleRules.load

rows = []
max_id = nil
while rows.size < count
  batch = api.statuses(
    account_id: config["fedibird"]["account_id"], max_id: max_id, limit: 40)
  break if batch.empty?
  batch.each do |st|
    next if st["reblog"] || st["in_reply_to_id"]
    text = SnsMultipost::HtmlText.to_text(st["content"].to_s)
    next if text.empty?
    rows << [titles.title_for(text), text.gsub(/\s+/, " ")[0, 40]]
    break if rows.size >= count
  end
  max_id = batch.last["id"]
end

out = rows.map { |r| r.join("\t") }.join("\n")
puts out
dir = File.expand_path("../logs", __dir__)
FileUtils.mkdir_p(dir)
path = File.join(dir, "dryrun_titles_#{Time.now.strftime('%Y%m%d-%H%M%S')}.tsv")
File.write(path, out)
puts "\nsaved: #{path}"
