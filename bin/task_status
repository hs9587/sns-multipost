#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "task_status"

task_name = "sns-multipost"
parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/task_status [options]",
  description: "sns-multipost用Windowsタスクスケジューラの状態を文字化けせず表示します。\nPowerShell、コマンドプロンプト、Git Bashから同じように実行できます。",
  examples: ["ruby bin/task_status", "ruby bin/task_status --task sns-multipost"],
  notes: ["既定のタスク名は sns-multipost です。",
          "タスクの状態を読み取るだけで、有効化・停止・実行は行いません。"]
) do |opts|
  opts.on("--task NAME", "確認するWindowsタスク名") do |value|
    task_name = value
  end
end
SnsMultipost::Cli.parse!(parser)
SnsMultipost::Cli.reject_arguments!(parser)
if task_name.to_s.strip.empty?
  SnsMultipost::Cli.usage_error(parser, "タスク名を指定してください")
end

begin
  status = SnsMultipost::TaskStatus.query(task_name)
  puts SnsMultipost::TaskStatus.format(status)
rescue StandardError => e
  warn e.message
  exit 1
end
