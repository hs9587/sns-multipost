#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "browser_profile"

parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/browser_login [options] SNS",
  description: "sns-multipostのブラウザ投稿専用Chromeプロファイルを開き、初回ログインを行います。\n対応SNSは mixi、mixi2 です。ログイン情報はstate/browser/に保存され、Gitには入りません。",
  examples: ["ruby bin/browser_login mixi", "ruby bin/browser_login mixi2"],
  notes: ["開いたChromeで本人がログインし、ホーム画面を確認してからChromeを閉じてください。",
          "このコマンドは投稿を行いません。普段使いのChromeプロファイルとは分離されます。"])
SnsMultipost::Cli.parse!(parser)

if ARGV.empty?
  SnsMultipost::Cli.usage_error(parser, "SNSを指定してください（mixi または mixi2）")
end
if ARGV.size > 1
  SnsMultipost::Cli.usage_error(parser, "余分な引数があります: #{ARGV.drop(1).join(' ')}")
end

service = ARGV.first.downcase
profile = SnsMultipost::BrowserProfile.new
begin
  pid = profile.launch(service)
rescue ArgumentError => e
  SnsMultipost::Cli.usage_error(parser, e.message)
end

puts "専用Chromeを開きました: #{service}"
puts "プロファイル: #{profile.profile_dir(service)}"
puts "ログイン後、ホーム画面を確認してChromeを閉じてください。"
Process.wait(pid)
puts "Chromeを閉じました。ログイン状態を保存しました。"
