#!/usr/bin/env ruby
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "cli"
require "config"
require "job_queue"
require "title_rules"
require "self_posted"
require "fedibird_api"
require "watch"

sync_only = false
parser = SnsMultipost::Cli.parser(
  banner: "Usage: ruby bin/watch [options]",
  description: "sns-multipostの入口としてFedibirdの新着を検出し、queue/に投稿ジョブを作成します。\n通常はこの後に ruby bin/run_queue を実行して、各SNSへ投稿します。",
  examples: ["ruby bin/watch", "ruby bin/watch --sync-only"],
  notes: ["このコマンドだけでは各SNSへの投稿は実行しません。",
          "通常実行はdry_runに関係なくジョブを作成します。",
          "--sync-onlyはキューを作らず、監視基準だけ最新へ進めます。"]) do |opts|
  opts.on("--sync-only", "キューを作らず監視基準だけ最新へ進める") do
    sync_only = true
  end
end
SnsMultipost::Cli.parse!(parser)
SnsMultipost::Cli.reject_arguments!(parser)

config = SnsMultipost::Config.load
watch = SnsMultipost::Watch.new(
  config: config,
  api: SnsMultipost::FedibirdApi.new(
    base_url: config["fedibird"]["base_url"],
    access_token: config["fedibird"]["access_token"]),
  queue: SnsMultipost::JobQueue.new,
  titles: SnsMultipost::TitleRules.load,
  self_posted: SnsMultipost::SelfPosted.new,
  state_path: File.expand_path("../state/since_id.txt", __dir__),
  media_root: File.expand_path("../state/media", __dir__))
count = watch.run(enqueue: !sync_only)
if sync_only
  puts "sync-only: 基準を最新に合わせました（キューは作りません）"
else
  puts "new statuses: #{count}"
end
